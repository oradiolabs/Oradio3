# constants.env — shared by install_oradio3.sh and Main/constants.py
# Literal assignments only: no $expansion, no backticks, no logic.

# Location of USB drive
USB_MOUNT_POINT=/media/oradio

# Location and key for posting to Remote Monitoring Service
RMS_SERVER_URL=https://oradiolabs.nl/rms/api/index.php/v1/oradiorms/records
RMS_SERVER_KEY=c60ee7a8fc01c609d0ff74aa07e4ef0295e645496e1a7aa404fbd28a899ca3d9

# Blink cycle, in seconds, for the LED that says the Oradio cannot run: an
# unsupported power supply, or a crash a reboot did not fix. The LED is on for
# the first half of each cycle and off for the second.
#
# Here rather than in either file that uses it, because both use it and they are
# in different languages: oradio_control.py drives the LED through led_control
# while the process lives, and oradio-crash.sh drives the same pin with pinctrl
# once it does not. Two copies would be two chances to retune one and forget the
# other, and the whole point is that the user sees one rate for one meaning.
#
# Deliberately different from the start-up blink, which is slower and means the
# opposite: busy, wait a moment.
ERROR_BLINK_CYCLE=0.7

# ALSA input PCM the Oradio plays its spoken prompts and tones through.
#
# Defined in asound.conf, used by system_sounds.py for every prompt while the
# Oradio runs, and by oradio-crash.sh for the one prompt that plays when it does
# not. Three files, one name: renaming it in one of them would break the other
# two silently, because ALSA reports an unknown PCM only at the moment of play.
SYSTEM_SOUND_SINK=SysSound_in

# BCM pin of the STOP/OFF LED.
#
# Driven by gpio_service.py through RPi.GPIO while the Oradio runs, and by
# oradio-crash.sh through pinctrl once the process is gone -- the same LED, the
# same fault, two ways of reaching it because only one of them works when there
# is no process left to hold a GPIO line open.
LED_STOP_PIN=23

# dnsmasq config that redirects every hostname to the captive portal.
#
# Written and removed by web_service.py in normal operation; removed by
# oradio-crash.sh after a crash, which is the case where web_service never got
# to clean up after itself. A path that drifted apart would leave the crash
# handler tidying a file nobody writes any more, without ever saying so.
DNS_REDIRECT_CONF=/etc/NetworkManager/dnsmasq-shared.d/redirect.conf
