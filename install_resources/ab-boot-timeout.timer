[Unit]
Description=Decide an A/B trial boot: commit if healthy, else roll back
Documentation=file:/usr/local/sbin/ab-boot-trial.sh

[Timer]
# Measured from boot, not from when the trial started, because the trial IS this boot.
# Long enough for a cold start to reach the point where the application knows it is
# healthy and calls `ab-boot-trial.sh commit`; short enough that a unit which boots
# but does not work is not left broken for long.
#
# Raise this if the application legitimately takes longer than five minutes to settle.
OnBootSec=5min

# A minute either way is immaterial here, and a loose tolerance lets systemd batch
# the wakeup instead of holding a precise timer for five minutes.
AccuracySec=10s

# Timer is triggered by the service.
Unit=ab-boot-timeout.service

[Install]
# The timer is what gets enabled, never the service it triggers.
WantedBy=timers.target
