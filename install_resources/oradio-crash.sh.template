#!/usr/bin/env bash
#
#  ####   #####     ##    #####      #     ####
# #    #  #    #   #  #   #    #     #    #    #
# #    #  #    #  #    #  #    #     #    #    #
# #    #  #####   ######  #    #     #    #    #
# #    #  #   #   #    #  #    #     #    #    #
#  ####   #    #  #    #  #####      #     ####
#
# Created on August 17, 2026
# @author:        Henk Stevens & Olaf Mastenbroek & Onno Janssen
# @copyright:     Stichting Oradio
# @license:       GNU General Public License (GPL)
# @organization:  Stichting Oradio
# @version:       1
# @email:         info@stichtingoradio.nl
# @status:        Development
# @Purpose:       Handle Oradio service crashes
#
# Started by oradio-crash.service, pulled in by 'OnFailure=' in oradio.service.
# It therefore runs ONLY after an abnormal exit: a regular 'systemctl stop' or
# a reboot never gets here.
#
# And only after the LAST abnormal exit. oradio.service retries once before it
# gives up, and its RestartMode=direct keeps the unit out of FAILED while that
# retry is pending -- so OnFailure= does not reach this script until the cheaper
# recovery has been tried and failed.
#
# Runs as root, in its own job, so systemctl calls are safe here.
# Output does NOT go to the journal: oradio-crash.service redirects both
# stdout and stderr to the crash action logfile in the logging path, so
# 'journalctl -u oradio-crash' stays empty. Read that logfile instead.
# It is uploaded to RMS along with the other logfiles, but necessarily without
# the lines written after the upload starts: see the marker below.
#

# Stop script on command errors, unset variables and failed pipes
set -o errexit -o nounset -o pipefail

# Uptime at the moment of the crash, for the report. Sampled here, not further
# down, because the RMS upload in between can take minutes on a slow link.
# Read from /proc/uptime and truncated to whole seconds.
read -r uptime _ < /proc/uptime
readonly uptime_at_crash="${uptime%.*}"

# Marker recording that this handler already rebooted the Oradio once.
#
# In /var/lib and not with the logfiles: it has to survive the reboot it is
# about to trigger, and it has to survive a user clearing the logging directory,
# or the second crash would be treated as a first one and reboot again.
readonly REBOOT_STAMP="/var/lib/oradio/crash-reboot.stamp"

# How long a reboot by this handler keeps counting. A crash inside this window
# is the second of a pair and gets the spoken message; a crash after it is
# treated as a fresh fault and gets its own reboot.
#
# Fifteen minutes: long enough that a fault which only shows once the user
# touches the radio still counts as the second crash, short enough that a
# genuinely unrelated crash next week does not.
readonly REBOOT_STAMP_VALID_MIN=15

# Spoken when a reboot has already been tried and the Oradio crashed again.
# There is nothing left for the software to do at that point, so the only useful
# act is telling the person in the room.
readonly SERVICE_SOUND="PLACEHOLDER_SOUNDS_PATH/ServiceRequired_melding.wav"

# How long to blink before leaving the LED on. The blinking is what catches
# someone's eye; the steady LED afterwards is what is still there when they come
# back later. Bounded because this script IS the last thing running for this
# fault -- blinking forever would mean never exiting, and oradio-crash.service
# would kill it at TimeoutStartSec anyway.
readonly LED_BLINK_SECONDS=30

# Cycle time from constants.env. One value, in one place, so the rate the user
# learns to recognise cannot come to mean two different things. The LED is on
# for the first half of each cycle.
LED_BLINK_HALF_CYCLE="$(awk "BEGIN{print PLACEHOLDER_ERROR_BLINK_CYCLE/2}")"
readonly LED_BLINK_HALF_CYCLE

# Collect the logfiles in the logging directory as curl -F arguments, using the
# filename as form field name. The glob is *.log* so rotated logs come along
# (oradio.log.1, oradio.log-20260822, oradio.log.1.gz); RMS accepts that shape
# and silently discards anything else, so sending other files would cost the
# upload time without ever storing them.
# Empty files are included: that a logfile exists but is empty is itself a
# finding, and distinguishing it from a file that was never created at all is
# exactly what a crash report is for. No nullglob needed: if nothing matches,
# the glob stays literal and the -f test skips it, leaving an empty array,
# which is safe to expand under nounset on bash 4.4+.
# The -f also skips subdirectories: curl cannot read a directory with -F @, and
# one stray subdirectory fails the whole upload, costing the entire report
# rather than just that one entry.
log_fields=()
for logfile in "PLACEHOLDER_LOGGING_PATH"/*.log*; do
	[ -f "$logfile" ] || continue
	log_fields+=(-F "$(basename "$logfile")=@${logfile}")
done

# Board serial, resolved here rather than inline in an -F argument: errexit is
# suspended across the curl (see below), so a failure inside that argument list
# would pass unnoticed and RMS would receive a valid looking report carrying no
# serial. The fallback also keeps a missing vcgencmd or a non-matching grep
# from aborting the script under errexit, which would skip the recovery that
# oradio-crash.service performs once this script returns.
# This must produce exactly what utilities.get_serial() produces, or the same
# Oradio arrives at RMS under two serials and its crash logs land apart from
# its heartbeats. Hence the anchored "^28:" rather than a substring match, the
# whitespace strip, the "Unknown" spelling, and the empty check on the second
# line, which covers a pipeline that succeeds but prints nothing.
serial="$(vcgencmd otp_dump | grep "^28:" | cut -c 4- | tr -d "[:space:]")" || serial="Unknown"
[ -n "$serial" ] || serial="Unknown"

# Reboot guard: one reboot per fault, not a loop.
#
# A first crash gets a reboot -- it clears whatever state the process was in and
# is almost always enough. A second crash shortly after that reboot means the
# reboot did not help, and repeating it would only produce an endless cycle with
# one RMS report per turn. So instead the Oradio says out loud that it needs
# service and stays visibly dead, which is the honest outcome: the software has
# run out of things to try.
#
# The marker is what tells the two apart, and it lives in /var/lib precisely
# because it has to outlive the reboot it records.
#
# Decided here, before the upload, so the uploaded copy of this log already
# states what the Oradio did next -- the one thing RMS could otherwise never
# learn from that copy.
if find "$REBOOT_STAMP" -mmin "-${REBOOT_STAMP_VALID_MIN}" 2>/dev/null | grep -q .; then
	will_reboot=0
	reboot_decision="second crash within ${REBOOT_STAMP_VALID_MIN}min of a crash reboot: NOT rebooting, asking for service instead"
else
	will_reboot=1
	reboot_decision="crash ${uptime_at_crash}s after boot: rebooting after this upload"

	# Written with the decision, not with the reboot it leads to.
	#
	# The reboot happens after the RMS upload, which takes up to CURL_TIMEOUT,
	# minutes on a slow link. A second crash inside that window would find no
	# marker, decide to reboot as well, and the pair would keep taking turns
	# instead of escalating. So the marker records that a reboot has been decided
	# and is under way, which is what a crash arriving mid-handling needs to know.
	#
	# Failing to write it is reported rather than fatal: the reboot below is still
	# the right thing to do, and the cost is that a second crash reboots again
	# instead of asking for service.
	mkdir -p "$(dirname "$REBOOT_STAMP")" && touch "$REBOOT_STAMP" \
		|| echo "Could not write ${REBOOT_STAMP}; a second crash will reboot again"
fi
readonly will_reboot reboot_decision

# Mark the cut in the crash action logfile. That file is one of the files being
# uploaded, and this script keeps writing to it afterwards: the RMS response is
# appended only after curl has read it. The copy on RMS therefore always ends
# here, while the original on the Oradio continues. Without the marker that copy
# looks like a script that stopped mid-run.
# No explicit flush is needed: bash flushes stdout before executing an external
# command, so this line is in the file by the time curl opens it.
echo "--- uploaded to RMS from here: any lines below exist only on the Oradio ---"
echo "--- decision already taken, executed after the upload: ${reboot_decision} ---"

# Send the logfiles to Oradio Remote Monitoring Service. Best effort: a failed
# upload must not abort the script, or the recovery that follows in the service
# unit is skipped, so errexit is suspended for the curl and its exit status is
# captured instead of acted on.
# The payload is up to 5MB, so --max-time is sized for the upstream bandwidth of
# a slow home connection rather than for the local link speed: 120s carries 5MB
# down to ~350kbps. The RMS server must be willing to keep receiving for at
# least as long: PHP's max_input_time caps that independently of
# max_execution_time, and when it expires mid-body PHP discards the request and
# RMS answers "Missing required field: serial", which reads as a payload fault
# rather than a slow link. Raise it there (.user.ini in the Joomla root) to
# above this value. --speed-limit / --speed-time abandon a connection that has
# stalled below 5kB/s for 30s, so a dead link fails fast instead of burning the
# full 120s. --max-time is per attempt, so worst case is 3 attempts of 120s plus
# 2 delays of 5s = 370s, which must stay below the TimeoutStartSec=500 of
# oradio-crash.service: curl has to lose that race, otherwise systemd
# kills the script before the recovery runs.
# The two failure reports are deliberately separate. --fail-with-body turns an
# HTTP 4xx/5xx into exit 22 while still capturing the body, so a rejected report
# is a real failure rather than a silent success, and it makes --retry retry on
# 5xx. -w appends the status code so the journal records which rejection it was:
# 401 (key rotated) and 413 (payload too large) call for different fixes, and
# exit 22 alone cannot tell them apart. Status 000 means no HTTP response was
# received at all, i.e. DNS, TLS or timeout, in which case the exit code is the
# informative half.
curl_exit=0
response="$(curl -sS --fail-with-body -w '\n%{http_code}' \
	--max-time 120 --retry 2 --retry-delay 5 \
	--speed-limit 5000 --speed-time 30 \
	-X POST "PLACEHOLDER_RMS_SERVER_URL" \
	-H "X-Api-Key: PLACEHOLDER_RMS_SERVER_KEY" \
	-F "generated=$(date "+%Y-%m-%d %H:%M:%S")" \
	-F "serial=${serial}" \
	-F "type=CRASH" \
	-F "source=Oradio service message" \
	-F "message=Oradio service fatal crash" \
	"${log_fields[@]}" \
	)" || curl_exit=$?

# -w put the status code on a line of its own after the body, so split the last
# line off. The -w newline guarantees there is one, so both expansions are safe
# even when the server returned nothing.
http_code="${response##*$'\n'}"
body="${response%$'\n'*}"

# Sole local record that the report was attempted, and the only place a server
# side rejection is visible. The last command is an unconditional echo, so the
# script exits 0 and the service continues to the recovery.
[ "$curl_exit" -eq 0 ] || echo "RMS report failed (curl exit ${curl_exit}, HTTP ${http_code})"
echo "RMS response: HTTP ${http_code}, body: ${body:-<none>}"

# Clean up state the crashed process would have removed itself.

# Written by web_service.py while the captive portal is up, and removed by its
# stop(). A crash skips that stop, so the file is left behind and survives the
# reboot. Harmless in client mode -- NetworkManager only reads this directory
# for a shared connection -- but it is state from a run that no longer exists.
# From constants.env, which web_service.py reads for the same path.
#
# Only this one file: everything else web_service.py sets up is runtime and
# gone after the reboot, and the WiFi returns to the saved client connection on
# its own. Removed whichever way the decision went, because it is stale in both.
if [ -e "PLACEHOLDER_DNS_REDIRECT_CONF" ]; then
	rm -f "PLACEHOLDER_DNS_REDIRECT_CONF" && echo "Removed leftover PLACEHOLDER_DNS_REDIRECT_CONF" \
		|| echo "Could not remove PLACEHOLDER_DNS_REDIRECT_CONF"
fi

# Execute the decision taken before the upload. Nothing is re-evaluated here:
# re-reading /proc/uptime would measure the upload as if it were runtime.
echo "Recovery: ${reboot_decision}"

if [ "$will_reboot" -eq 0 ]; then
	# A reboot has already been tried and did not help. Say so out loud using
	# ALSA sink for system sounds from constants.env. Nobody is watching a log.
	# An Oradio that is silently dead looks the same as one that is switched off.
	#
	# Blocking, not detached: this script is the last thing running for this
	# fault, and exiting would take the sound with it.
	# Started in the background so the blinking below runs with it rather than
	# after it: the message lasts about four seconds and the blinking thirty, so
	# the sound finishes well inside the loop and someone in the room hears and
	# sees the same thing at the same moment.
	#
	# Safe only because of that margin. If the blinking is ever shortened below
	# the length of the message, this has to go back to being blocking, or the
	# script exits and takes the sound with it.
	if [ -r "$SERVICE_SOUND" ]; then
		aplay -D "PLACEHOLDER_SYSTEM_SOUND_SINK" "$SERVICE_SOUND" \
			|| echo "Could not play ${SERVICE_SOUND} on PLACEHOLDER_SYSTEM_SOUND_SINK" &
	else
		echo "Service message not played: ${SERVICE_SOUND} is missing or unreadable"
	fi

	# And the same message visually, for a room nobody was in when it spoke.
	#
	# pinctrl writes the pad register directly, so the BCM pin of the STOP/OFF LED
	# from constants.env keeps whatever it was left on after the command exits.
	# That is the whole reason for using it here rather than the GPIO library the
	# Oradio uses: nothing survives this script to hold a line open, and a LED that
	# goes dark the moment the handler exits would say nothing at all.
	if command -v pinctrl >/dev/null 2>&1; then
		blink_until=$(( SECONDS + LED_BLINK_SECONDS ))
		while [ "$SECONDS" -lt "$blink_until" ]; do
			pinctrl set "PLACEHOLDER_LED_STOP_PIN" op dh || break
			sleep "$LED_BLINK_HALF_CYCLE"
			pinctrl set "PLACEHOLDER_LED_STOP_PIN" op dl || break
			sleep "$LED_BLINK_HALF_CYCLE"
		done

		# Left ON, not off: the blinking ends but the fault does not, and this
		# is the only sign left once the sound has finished and the blinking has
		# stopped. It stays lit until the next boot, which is correct -- nothing
		# is going to fix itself in between.
		pinctrl set "PLACEHOLDER_LED_STOP_PIN" op dh \
			|| echo "Could not leave GPIO PLACEHOLDER_LED_STOP_PIN on"
	else
		echo "LED not used: pinctrl is not installed"
	fi

	# Collect the backgrounded aplay. Without pinctrl there is no blink loop to
	# have outlasted it, so this is also what keeps the sound from being cut off
	# on a device where the LED cannot be used.
	wait

	# The marker is deliberately NOT removed. It ages out by itself, and until it
	# does, a third crash lands here again rather than starting a reboot cycle.
	exit 0
fi

# Ensure buffered data is written to files
sync

# Let systemd do controlled reboot
systemctl reboot

# For future try to recover:
#	- Restore settings to factory defaults
#	- Restart oradio service
