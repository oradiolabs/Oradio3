# Placeholders will be modified by ../oradio_install.sh script
#
# Installed as /etc/systemd/system/oradio-crash.service
#
# Pulled in by 'OnFailure=oradio-crash.service' in oradio.service, which fires
# when oradio.service enters the FAILED state, i.e. when the python script died
# abnormally. A regular stop or reboot does not trigger it.
#
# Do NOT 'systemctl enable' this unit: it has no [Install] section on purpose,
# so it can never be started at boot. It only ever runs as a failure handler.

[Unit]
Description=Oradio crash action (runs when oradio.service crashes)

[Service]
# Type=oneshot is what the systemd docs recommend for OnFailure handlers: the
# job runs to completion and the unit does not stay active, so a later crash
# re-triggers it cleanly instead of being ignored as 'already running'.
Type=oneshot

# Log file permissions applied when the logfile is CREATED. 0002 yields -rw-rw-r-- (0664).
UMask=0002

# Redirect stdout (fd 1) and stderr (fd 2) to the log file.
#
# This takes the output OUT of the journal: journalctl -u oradio-crash shows
# only systemd's own start/stop lines. Deliberate - the journal is
# Storage=volatile and is lost on every reboot, so the log file is the only
# record that survives.
StandardOutput=append:PLACEHOLDER_LOGFILE_CRASH
StandardError=append:PLACEHOLDER_LOGFILE_CRASH

# No chown of the log file here: oradio_install.sh creates it as
# PLACEHOLDER_USER, and logrotate uses copytruncate with 'su', so the inode
# persists and ownership cannot drift.

# The traceback logfile is still on disk and untouched at this point; it is only
# cleared by the next start of oradio.service, so the script can read or copy it
# if the crash action needs it.

# Runs as its own job, outside oradio.service's stop transition, so calling
# systemctl from the script cannot deadlock.
ExecStart=/usr/local/sbin/oradio-crash.sh

# Type=oneshot defaults to TimeoutStartSec=infinity, NOT to the 90s default that
# other service types get. Sized for the worst case in oradio-crash.sh, which is
# posting to the remote monitoring service over a slow or absent network.
TimeoutStartSec=500

# No [Install] section: see the header. This unit is reached only via OnFailure=.
