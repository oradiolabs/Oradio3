# Oradio log rotation
#
# Install as /etc/logrotate.d/oradio
#
# All Oradio logs share one policy, so a glob replaces the per-file blocks.
# Rotated files are named *.log.1, which does not match *.log, so they are
# not picked up again on the next run.
#
# 'size 250k' is threshold-based, not time-based: logrotate rotates whenever the
# file exceeds 250k at the moment it runs, and ignores daily/weekly directives
# entirely. How often that check happens is therefore set by logrotate.timer.

PLACEHOLDER_LOGGING_PATH/*.log {
	# Act as the owner of the log directory rather than as root.
	su PLACEHOLDER_USER PLACEHOLDER_GROUP

	# Rotate once the file passes 250k; keep one previous generation.
	# Steady state is therefore about 500k per log.
	size 250k
	rotate 2

	# Do not fail the whole run if a log has not been created yet.
	missingok

	# Nothing to do for a zero-length log
	notifempty

	# Logs are small and read during support calls; keep them greppable.
	nocompress

	# Oradio holds these files open, so the inode must not change.
	# copytruncate briefly doubles the space used by the log being
	# rotated, which at 250k is negligible.
	copytruncate
}
