[Unit]
Description=Decide an A/B trial boot: commit if healthy, else roll back
Documentation=file:/usr/local/sbin/ab-boot-trial.sh
# Needs the boot partition mounted: the trial state lives there.
After=local-fs.target
# Deliberately no [Install] section: this is started by ab-boot-timeout.timer and
# by nothing else. Enabling it would run the timeout at every boot, ending a
# trial the moment it began.

[Service]
# Service runs a single task and then exits.
Type=oneshot

# Log file permissions applied when the logfile is CREATED. 0002 yields -rw-rw-r-- (0664).
UMask=0002

# Redirect stdout (fd 1) and stderr (fd 2) to the Oradio log file.
# Note this takes the output *out* of the journal: journalctl -u ab-boot-timeout will be empty.
StandardOutput=append:PLACEHOLDER_LOGFILE_BOOT
StandardError=append:PLACEHOLDER_LOGFILE_BOOT

# Set logfile ownership. '+' means run this command as root.
ExecStartPre=-+/usr/bin/chown PLACEHOLDER_USER:PLACEHOLDER_GROUP PLACEHOLDER_LOGFILE_BOOT

# 'timeout' decides an undecided trial. If HEALTH_UNIT is running and has not
# been restarting, the trial is committed; otherwise it is declared failed, the
# version is recorded so the same package is not installed again, the tryboot
# files are removed and the board reboots into the committed slot.
ExecStart=/usr/local/sbin/ab-boot-trial.sh timeout
