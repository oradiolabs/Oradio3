[Unit]
# Do NOT rename these units to swupdate.path / swupdate.service: the swupdate
# package ships units of that name, and replacing them makes the distro's
# swupdate.socket try to activate this script instead.
Description=Install an Oradio3 software update
Documentation=file:/usr/local/sbin/oradio3-update.sh
# The rootfs and the boot partition both have to be mounted: the package is read
# from a mounted medium and the trial-failure record it consults lives there.
After=local-fs.target
Requires=local-fs.target

[Service]
# Service runs a single task and then exits.
Type=oneshot

# Run software update script
ExecStart=/usr/local/sbin/oradio3-update.sh

# Log file permissions applied when the logfile is CREATED. 0002 yields -rw-rw-r-- (0664).
UMask=0002

# Redirect stdout (fd 1) and stderr (fd 2) to the Oradio log file.
# Note this takes the output *out* of the journal: journalctl -u oradio3-update will be empty.
StandardOutput=append:PLACEHOLDER_LOGFILE_UPDATE
StandardError=append:PLACEHOLDER_LOGFILE_UPDATE

# Set logfile ownership. '+' means run this command as root.
ExecStartPre=-+/usr/bin/chown PLACEHOLDER_USER:PLACEHOLDER_GROUP PLACEHOLDER_LOGFILE_UPDATE

# Unpacking a rootfs onto an SD card takes minutes. The default 90s start
# timeout would kill the install part-way through, leaving the inactive slot
# half-written — recoverable, but only because the running slot is untouched.
TimeoutStartSec=0

# The script reboots on success, so systemd sees the unit interrupted rather
# than finished. Nothing should try to restart or repair that.
Restart=no

# Enough privilege to format the inactive slot and write the boot partition.
User=root
