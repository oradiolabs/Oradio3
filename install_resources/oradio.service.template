# Placeholders will be modified by ../oradio_install.sh script

[Unit]
Description=Oradio
After=basic.target

# Crash handling. There is no automatic restart (Restart=no below), so any abnormal exit
# puts this unit straight into the FAILED state and OnFailure= starts the crash action.
#
# The OnFailure handler is a separate job, so it may call systemctl without deadlocking
# against oradio's own stop transition.
OnFailure=oradio-crash-action.service

[Service]
# oradio_control.py runs in the foreground and never daemonizes, so 'simple' is
# the right type: systemd treats the ExecStart process itself as the main process,
# and considers the unit started as soon as it has been forked, without waiting 
# for the script to become ready. Consequences worth knowing:
#   - units ordered After=oradio.service may start before Oradio is actually up.
#     Only Type=notify (with sd_notify from python) would fix that.
#   - when that process exits, for any reason, the unit is 'stopped' and
#     Restart=always kicks in after RestartSec.
#   - ExecStartPre commands still run to completion before ExecStart starts.
Type=simple

# Scheduling priority is applied by optimize_boot_time.sh as a drop-in
# at /etc/systemd/system/oradio.service.d/oradio-sched.conf:
#   [Service]
#   Nice=-5
#   IOSchedulingClass=best-effort
#   IOSchedulingPriority=0

# Log file permissions applied when the logfile is CREATED. 0002 yields -rw-rw-r-- (0664).
UMask=0002

# Redirect stdout (fd 1) and stderr (fd 2) to the log file.
# Note this takes the output *out* of the journal: journalctl -u oradio will be empty.
StandardOutput=append:PLACEHOLDER_LOGFILE_TRACEBACK
StandardError=append:PLACEHOLDER_LOGFILE_TRACEBACK

# Set logfile ownership. '+' means run this command as root.
ExecStartPre=-+/usr/bin/chown PLACEHOLDER_USER:PLACEHOLDER_GROUP PLACEHOLDER_LOGFILE_TRACEBACK

# Clear traceback logfile when starting the service
ExecStartPre=/usr/bin/truncate -s 0 PLACEHOLDER_LOGFILE_TRACEBACK

# For boot time tracing: Timestamp when oradio service starts.
ExecStartPre=-/bin/sh -c 'echo "Oradio python script started after boot: $(cut -d" " -f1 /proc/uptime)s" >> PLACEHOLDER_LOGFILE_BOOT'

# Execute service in user environment.
User=PLACEHOLDER_USER
Group=PLACEHOLDER_GROUP

# Start Oradio
WorkingDirectory=PLACEHOLDER_MAIN_PATH
ExecStart=/home/PLACEHOLDER_USER/.venv/bin/python3 oradio_control.py

# No automatic restart: recovery is the crash action script's job.
# Stopping the service in a regular way has no further action.
Restart=no

[Install]
WantedBy=multi-user.target
