# Placeholders will be modified by ../oradio_install.sh script
#
# Installed as /etc/systemd/system/oradio-crash-action.service
#
# Pulled in by 'OnFailure=oradio-crash-action.service' in oradio.service, which
# fires when oradio.service enters the FAILED state, i.e. when the python script
# died abnormally. A regular stop or reboot does not trigger it.
# Do NOT 'systemctl enable' this unit: it has no [Install] section on purpose,
# so it can never be started at boot. It only ever runs as a failure handler.

[Unit]
Description=Oradio crash action (runs when oradio.service crashes)

[Service]
# Type=oneshot is what the systemd docs recommend for OnFailure handlers: the
# job runs to completion and the unit does not stay active, so a later crash
# re-triggers it cleanly instead of being ignored as 'already running'.
Type=oneshot

# No User=/Group=: the handler runs as root, so it may restart oradio, reboot, ...

# stdout/stderr are NOT redirected: unlike oradio.service, everything the
# script prints lands in the journal, where it stays out of the traceback
# logfile that has just been reported to RMS.
#   journalctl -u oradio-crash-action

# The traceback logfile is still on disk and untouched at this point; it is
# only cleared by the next start of oradio.service, so the script can read or
# copy it if the crash action needs it.

# Runs as its own job, outside oradio.service's stop transition, so calling
# systemctl from the script cannot deadlock.
ExecStart=/usr/local/sbin/oradio-crash-action.sh

# Give the script enough time to execute: at least enough for post to rms, which
# with curl --max-time 60 --retry 2 --retry-delay 5 can take up to 190 seconds.
TimeoutStartSec=300
