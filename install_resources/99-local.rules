# USB drive handler for devices labelled ORADIO.
#
# Both rules hand off to systemd rather than doing work here: udev RUN commands are killed once the event handler returns,
# so anything long-lived must live in a unit.
#
# --no-block is essential. Without it, systemctl waits for the oneshot unit to finish, which parks a udev worker for the whole
# duration of the mount. That risks hitting udev's 180s event_timeout, and can deadlock against systemd waiting on udev to settle.

# Partition with label ORADIO inserted -> start the handler with action "add"
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_FS_LABEL}=="ORADIO", RUN+="/usr/bin/systemctl --no-block start usb-drive@add.service"

# Same partition removed -> start the handler with action "remove".
# On remove events udev replays the properties it stored in its database,
# so DEVTYPE and ID_FS_LABEL still match even though the device is already gone.
ACTION=="remove", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_FS_LABEL}=="ORADIO", RUN+="/usr/bin/systemctl --no-block start usb-drive@remove.service"