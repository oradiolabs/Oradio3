#!/usr/bin/env bash
#
# Handles USB drive mount/unmount for devices labelled ORADIO.
#
# Invoked three ways, with the action as the first argument:
#   boot    - usb-drive-boot.service, once per boot. The stick may not exist yet,
#             and may never exist.
#   add     - usb-drive@add-<SEQNUM>.service, from a udev add/change event for a
#             partition labelled ORADIO. Waits up to DEVICE_WAIT for it.
#   remove  - usb-drive@remove-<SEQNUM>.service, from a udev remove event on any
#             sd* partition.
#
# All three do the same thing: make the mount match reality.
#   - mounted from the stick that is plugged in now  -> nothing to do
#   - mounted from anything else (stick gone, or a
#     leftover from its previous insertion)          -> detach
#   - ORADIO stick present and not mounted           -> fsck if dirty, mount
# "The stick" is identified by partition AND kernel diskseq, recorded at mount
# time in $IDENTITY, because a re-inserted stick usually gets the same name.
# The action only decides how long to wait for a stick to appear. Nothing
# depends on events arriving, or winning the lock, in order.
#
# Stop on errors (-e), catch unset variables (-u), catch failures in a pipeline (-o pipefail)
set -euo pipefail

# udev starts one unit instance per event (usb-drive@add-<SEQNUM>.service), so
# the instance name carries a suffix. Only the part before the first '-' is the
# action. See 99-local.rules for why every event needs its own instance.
ACTION="${1:-}"
ACTION="${ACTION%%-*}"
BY_LABEL="/dev/disk/by-label/ORADIO"		# Stable symlink; survives device renumbering
MOUNTPOINT="PLACEHOLDER_USB_MOUNT_POINT"	# Location where USB is mounted
MONITOR="/run/usb_present"					# RAM-based flag file; present = mounted
FSCK_ERROR="/run/usb_fsck_error"			# Written when fsck could not repair; read and removed by usb_service
LOCK="/run/usb_mount.lock"					# Prevents concurrent runs from duplicate udev events
IDENTITY="/run/usb_mounted"					# Which physical stick is mounted: "<partition> <diskseq>"

# Seconds to wait for the lock before giving up. Must cover a full fsck of a
# large stick plus a mount, because the instance still waiting is usually the
# one carrying the LAST event, which should no be lost.
# TimeoutStartSec in usb-drive@.service covers LOCK_WAIT + FSCK_TIMEOUT.
LOCK_WAIT=100

# Upper bound on fsck.vfat. A stick pulled mid-check can leave fsck waiting on
# usb-storage error recovery for a long time while it holds the lock.
FSCK_TIMEOUT=60

# Seconds to poll for the ORADIO partition before giving up. Does not delay the
# boot: usb-drive-boot.service has DefaultDependencies=no and no Before=, so
# nothing is ordered after it.
DEVICE_WAIT=5

# USB autosuspend for the ORADIO stick only. The kernel defaults power/control
# to 'on' (never suspend) for every USB device except hubs; this sets 'auto' on
# the stick's own USB device, found by walking up sysfs from the mounted
# partition. Hub, Ethernet dongle and keyboard keep the kernel default.
# Idle time in ms before the stick is suspended. Set to 0 to disable the feature.
AUTOSUSPEND_DELAY_MS=30000
# Idle time in ms before the stick's SCSI disk may suspend; must be >= 0.
SCSI_AUTOSUSPEND_DELAY_MS=5000

# Fix PLACEHOLDER_LOGFILE_USB ownership. Both units redirect StandardOutput= here, and systemd
# does that open as root, so a PLACEHOLDER_LOGFILE_USB that was deleted comes back root:root on
# the next boot. Nothing then repairs it: logrotate runs under 'su PLACEHOLDER_USER' and cannot
# truncate a root-owned file, so that log silently stops rotating and grows without bound.
#
# Done here rather than as an ExecStartPre= in the two units because both already run this
# script as root, so it costs no extra fork - and usb-drive-boot.service is the boot fast path,
# where forks are exactly what it is trying to avoid.
#
# Position is load-bearing: this must stay above the lock and above the early exits, including
# the 'boot' path's exit 0 when no stick is fitted. That run still has to leave the file owned
# correctly, because it is usually the first thing to touch usb.log after a reboot.
#
# '|| true' so a manual unprivileged run does not abort here. The chown is not this script's
# job, only its side effect.
chown PLACEHOLDER_USER:PLACEHOLDER_GROUP "PLACEHOLDER_LOGFILE_USB" 2>/dev/null || true

# Milliseconds since the epoch, without forking date. EPOCHREALTIME is
# seconds.microseconds and uses the locale decimal separator, so strip either.
now_ms() { local us="${EPOCHREALTIME/[.,]/}"; printf '%s' "$(( us / 1000 ))"; }

T_START="$(now_ms)"

# Milliseconds since this script started, for spotting where the time goes.
since_start() { printf '%s' "$(( $(now_ms) - T_START ))"; }

# Logging helper: prefixes every message with a timestamp.
# printf '%(...)T' is a bash builtin, so this costs no fork.
log() { printf '%(%F %T)T %s\n' -1 "$*"; }

# Last kernel log timestamp, used to select messages emitted after this point.
kmsg_mark() {
	local line
	line="$(dmesg 2>/dev/null | tail -n1)" || true
	line="${line#\[}"
	line="${line%%\]*}"
	line="${line// /}"
	[[ "$line" =~ ^[0-9]+\.[0-9]+$ ]] && printf '%s' "$line" || printf '0.000000'
}

# Report what the kernel said about this device since the mark.
#
# mount(8) exiting 0 does NOT mean the filesystem is healthy. The vfat driver
# reports the dirty bit, a bad boot sector, and later I/O or corruption errors
# only to the kernel log - mount's own stderr stays empty. Without this a
# damaged stick that mounts looks identical in the log to a healthy one.
#
# Timestamps are compared as integers with the decimal point removed. dmesg
# prints a fixed six decimals, so the comparison is exact.
log_kernel_messages() {
	local since="$1" name="$2" line ts
	# 10# forces base 10: dmesg pads to six decimals, so removing the point can
	# leave a leading zero, and bash would read that as octal and refuse any
	# string containing an 8 or a 9.
	local since_i=$(( 10#${since/./} ))

	# grep first: the ring buffer holds hundreds of lines and looping over all of
	# them in bash costs more than the mount being reported on. Only lines naming
	# this device reach the timestamp comparison, so no further filter is needed.
	while IFS= read -r line; do
		ts="${line#\[}"
		ts="${ts%%\]*}"
		ts="${ts// /}"
		[[ "$ts" =~ ^[0-9]+\.[0-9]+$ ]] || continue
		(( 10#${ts/./} > since_i )) || continue
		log "Kernel: ${line#*] }"
	done < <(dmesg 2>/dev/null | grep -F "($name)" || true)
}

# True if the FAT dirty flag is set on this partition.
#
# Hot-unplug always sets it: udev's remove event fires after the device is gone,
# so umount cannot write the clean state back. Linux will not clear a bit it did
# not set, so it persists until fsck runs.
#
# Reads the one byte rather than running fsck to find out: fsck walks the whole
# FAT, this is a single sector read. The flag sits at 0x41 for FAT32 and 0x25
# for FAT12/16; an unrecognised layout returns false rather than guessing.
fat_dirty() {
	local part="$1" ver off byte
	ver="$(blkid -p -o value -s VERSION "$part" 2>/dev/null || true)"
	case "$ver" in
		FAT32)       off=65 ;;
		FAT12|FAT16) off=37 ;;
		*)           return 1 ;;
	esac
	byte="$(dd if="$part" bs=1 skip="$off" count=1 status=none 2>/dev/null | od -An -tu1 | tr -d '[:space:]')"
	[[ "$byte" =~ ^[0-9]+$ ]] || return 1
	(( byte & 1 ))
}

# Locate the ORADIO partition, polling until the deadline expires.
#
# Two independent methods, tried together on every pass:
#   1. Direct blkid probe of the raw partition nodes. devtmpfs creates these the
#      moment the kernel finds the partition, so this can succeed long before
#      udev has finished with the device.
#   2. The by-label symlink, created by 60-persistent-storage.rules.
#
# Both are polled, rather than trying method 1 once and then falling back. A
# single probe of method 1 fails whenever the stick is not yet answering blkid,
# and in exactly that situation method 2 is not ready either - the same
# unreadable device is why udev has no label for it. Trying each once therefore
# gives up at the moment both are guaranteed to fail.
#
# Method 1 lets the boot path beat udev's worker queue; method 2 is the backstop
# for a device whose raw node is not probeable but which udev has labelled.
find_oradio_part() {
	local wait_s="$1"
	local deadline p
	# Measured from now, not from T_START: an instance that queued behind the
	# lock (a long fsck, say) would otherwise arrive with its deadline already
	# spent and get a single probe of a stick that is still settling.
	deadline=$(( $(now_ms) + wait_s * 1000 ))

	while :; do
		for p in /dev/sd[a-z][0-9]*; do
			[ -b "$p" ] || continue
			if [ "$(blkid -p -o value -s LABEL "$p" 2>/dev/null)" = "ORADIO" ]; then
				printf '%s\n' "$p"
				return 0
			fi
		done

		if [ -b "$BY_LABEL" ]; then
			readlink -f "$BY_LABEL"
			return 0
		fi

		[ "$(now_ms)" -lt "$deadline" ] || return 1
		sleep 0.1
	done
}

# Identity of the physical stick behind a partition node: "<node> <diskseq>".
#
# The kernel name alone is not enough. Pull the stick and put it back and it is
# very often /dev/sda1 again, while a mount left over from the first insertion
# still says /dev/sda1 too - the node exists, the source matches, and the mount
# is dead. diskseq is a per-boot counter the kernel assigns on every disk
# attach, so it tells the two apart. Kernels without it (pre-5.15) fall back to
# the ctime of the devtmpfs node, which is also set when the node is recreated.
part_identity() {
	local node name sys seq
	node="$(readlink -f "$1")"
	name="$(basename "$node")"
	sys="$(readlink -f "/sys/class/block/$name" 2>/dev/null || true)"
	seq=""
	if [ -n "$sys" ] && [ -r "$sys/../diskseq" ]; then
		seq="$(cat "$sys/../diskseq" 2>/dev/null || true)"
	fi
	[ -n "$seq" ] || seq="ctime$(stat -c %Z "$node" 2>/dev/null || echo 0)"
	printf '%s %s' "$node" "$seq"
}

# Detach the mount without touching the device.
#
# Only ever called when the mounted stick is gone (or is a different attach of
# it), so a clean umount has nothing to write to: it cannot clear the FAT dirty
# bit, and on a half-gone device it can sit in usb-storage error recovery while
# this script holds the lock. A lazy unmount detaches immediately and lets MPD
# drop its open file in its own time. No lsof here for the same reason - it
# stats every open file and can block on exactly this dead filesystem.
detach_mount() {
	local reason="$1"

	# The updater reads the .swu straight off the stick. Stop it so it releases
	# its handles; re-inserting the stick restarts the install from the top.
	if systemctl is-active --quiet oradio3-update.service; then
		log "Warning: oradio3-update.service active; stopping it before unmount"
		timeout 30 systemctl stop oradio3-update.service \
			|| log "Error: could not stop oradio3-update.service within 30s"
	fi

	log "Info: detaching '$MOUNTPOINT' ($reason) ($(since_start)ms)"
	umount -l "$MOUNTPOINT" 2>/dev/null || true
	if mountpoint -q "$MOUNTPOINT" 2>/dev/null; then
		log "Error: failed to detach '$MOUNTPOINT'"
		return 1
	fi
	rm -f "$MONITOR" "$IDENTITY"
	rmdir "$MOUNTPOINT" 2>/dev/null || true
	log "Success: '$MOUNTPOINT' detached ($(since_start)ms)"
}

# Allow runtime suspend of the USB device behind this partition.
#
# Scope is deliberately this one stick: the sysfs walk starts at the ORADIO
# partition and stops at the first ancestor with idVendor, which is the stick's
# own usb_device - never the hub above it. A re-inserted stick is a new device
# with power/control back at 'on', which is fine: every mount comes through here.
#
# The USB device can only suspend once everything below it is runtime-idle,
# so the disk layer needs three settings as well (verified on a Pi 3A+):
#  - sdX/events_poll_msecs = 0: sticks report 'removable', so the kernel polls
#    them for media change (TEST UNIT READY every 2 s by default). Each poll
#    restarts the idle timer, so the disk never sleeps. Physical removal is
#    reported by the USB layer, so a stick loses nothing without this polling.
#  - sdX/device/power/autosuspend_delay_ms: the block layer starts it at -1,
#    which means never. The long wait lives on the USB device; this one is short.
#  - sdX/device/power/control = auto.
#
# Failures are logged, never fatal: a stick that cannot suspend still plays.
# Write a sysfs attribute; log instead of failing, so a stick that cannot
# suspend still mounts and plays.
set_attr() {
	if [ ! -w "$1" ]; then
		log "Warning: autosuspend: '$1' not writable"
	elif ! echo "$2" > "$1" 2>/dev/null; then
		log "Warning: autosuspend: could not write '$2' to '$1'"
	fi
}

enable_autosuspend() {
	local part="$1" sys dev disk
	(( AUTOSUSPEND_DELAY_MS > 0 )) || return 0

	sys="$(readlink -f "/sys/class/block/$(basename "$(readlink -f "$part")")" 2>/dev/null || true)"
	[ -n "$sys" ] || { log "Warning: autosuspend: no sysfs node for '$part'"; return 0; }

	dev="$sys"
	while [ "$dev" != "/" ] && [ ! -f "$dev/idVendor" ]; do
		dev="$(dirname "$dev")"
	done
	if [ ! -w "$dev/power/control" ]; then
		log "Warning: autosuspend: no USB device found above '$part'"
		return 0
	fi

	# A partition sits one level below its disk; a stick without a partition
	# table has the filesystem on the disk itself.
	if [ -f "$sys/partition" ]; then disk="$(dirname "$sys")"; else disk="$sys"; fi
	set_attr "$disk/events_poll_msecs" 0
	set_attr "$disk/device/power/autosuspend_delay_ms" "$SCSI_AUTOSUSPEND_DELAY_MS"
	set_attr "$disk/device/power/control" auto

	echo "$AUTOSUSPEND_DELAY_MS" > "$dev/power/autosuspend_delay_ms" 2>/dev/null \
		|| log "Warning: autosuspend: could not set delay on '$dev'"
	if echo auto > "$dev/power/control" 2>/dev/null; then
		log "Info: autosuspend enabled for $(cat "$dev/idVendor"):$(cat "$dev/idProduct") at '$dev' (${AUTOSUSPEND_DELAY_MS}ms)"
	else
		log "Warning: autosuspend: could not set '$dev/power/control'"
	fi
}

# fsck if dirty, mount, record identity, raise the flag for usb_service.
mount_partition() {
	local part="$1" fstype fsck_out fsck_rc opts mount_err kmark

	fstype="$(blkid -p -o value -s TYPE "$part" 2>/dev/null || true)"
	log "Info: found ORADIO at '$part' type '${fstype:-unknown}' ($(since_start)ms)"
	# A stick reformatted as exfat or ntfs and relabelled ORADIO passes the label
	# match and then fails the vfat mount with a message that does not say why.
	if [ -n "$fstype" ] && [ "$fstype" != "vfat" ]; then
		log "Error: '$part' is '$fstype', not vfat; refusing to mount"
		return 1
	fi

	# Hot-unplug always leaves the dirty bit set, so on a re-insert this runs
	# every time. Bounded: see FSCK_TIMEOUT.
	if fat_dirty "$part"; then
		log "Warning: dirty bit set on '$part'; running fsck ($(since_start)ms)"
		set +e
		fsck_out="$(timeout "$FSCK_TIMEOUT" fsck.vfat -a "$part" 2>&1)"
		fsck_rc=$?
		set -e
		if (( fsck_rc <= 1 )); then
			log "Info: fsck repaired '$part' ($(since_start)ms)"
		elif [ ! -b "$part" ]; then
			# Pulled mid-check. Not damage, and not worth an incident: the
			# remove event for it is already queued.
			log "Info: '$part' disappeared during fsck (rc=$fsck_rc)"
			return 0
		else
			log "Error: fsck.vfat rc=$fsck_rc on '$part': $fsck_out"
			# Hand the failure to usb_service, which owns the incident bus.
			{
				echo "partition: $part"
				echo "fsck.vfat rc=$fsck_rc"
				echo "$fsck_out"
			} > "$FSCK_ERROR" || log "Warning: could not write '$FSCK_ERROR'"
		fi
	fi

	mkdir -p "$MOUNTPOINT"

	# Mount options chosen to reduce risk of data loss on FAT volumes:
	#   rw, users (implies noexec,nosuid,nodev), uid=0, gid=100 (users),
	#   fmask=111, dmask=000, utf8=1, noatime, nodiratime,
	#   flush (write FAT metadata promptly), sync (no deferred writeback)
	opts="rw,users,uid=0,gid=100,fmask=111,dmask=000,utf8=1,noatime,nodiratime,flush,sync"

	kmark="$(kmsg_mark)"
	if ! mount_err=$(mount -t vfat -o "$opts" "$part" "$MOUNTPOINT" 2>&1); then
		log "Error: mounting '$part' failed: $mount_err"
		log_kernel_messages "$kmark" "$(basename "$part")"
		return 1
	fi

	part_identity "$part" > "$IDENTITY"

	# The flag must be CREATED, not merely touched: usb_service reacts to
	# IN_CREATE, and touching a leftover flag produces no event at all - the
	# insert would go unannounced. A leftover flag is only possible after a
	# path that bypassed detach_mount(), so removing it first is cheap insurance.
	rm -f "$MONITOR"
	touch "$MONITOR"
	log "Success: mounted '$part' at '$MOUNTPOINT' as '$(cat "$IDENTITY")' ($(since_start)ms)"

	# A successful mount is not a healthy filesystem - see log_kernel_messages.
	log_kernel_messages "$kmark" "$(basename "$part")"

	enable_autosuspend "$part"

	# Hand any software update package to the update service.
	# --no-block: installing takes minutes and ends in a reboot, and we hold $LOCK.
	if compgen -G "$MOUNTPOINT/*.swu" >/dev/null; then
		log "Software update package found; starting oradio3-update.service"
		systemctl start --no-block oradio3-update.service \
			|| log "Error: could not start oradio3-update.service"
	fi
}

# Acquire an exclusive lock for the duration of this script.
#
# Every run below is a reconcile against what is true NOW - which stick is
# plugged in, what is mounted - and never against what the triggering event
# said. That is what makes the lock's non-FIFO ordering harmless: when a
# remove for the previous insertion wins the lock after the add for the next
# one, it sees the new stick mounted and present and leaves it alone.
exec 9>"$LOCK"
if ! flock -x -w "$LOCK_WAIT" 9; then
	log "Error: timed out after ${LOCK_WAIT}s waiting for '$LOCK' (action '$ACTION')"
	exit 1
fi
log "Info: action '$ACTION' has the lock ($(since_start)ms)"

case "$ACTION" in
	# boot:   usb-drive-boot.service; stick may legitimately be absent.
	# add:    udev saw an ORADIO label; wait for a slow stick to settle.
	# remove: a partition went away; look, do not wait - if a new stick is
	#         already in, it is found on the single pass.
	boot | add) WAIT="$DEVICE_WAIT" ;;
	remove)     WAIT=0 ;;
	*)
		log "Error: unknown action: '$ACTION'"
		exit 1
		;;
esac

PARTITION="$(find_oradio_part "$WAIT" || true)"

if mountpoint -q "$MOUNTPOINT" 2>/dev/null; then
	WANT=""
	[ -n "$PARTITION" ] && WANT="$(part_identity "$PARTITION")"
	HAVE="$(cat "$IDENTITY" 2>/dev/null || true)"

	if [ -z "$HAVE" ] && [ -n "$PARTITION" ] \
		&& [ "$(readlink -f "$(findmnt -n -o SOURCE --mountpoint "$MOUNTPOINT")")" = "$PARTITION" ]; then
		# Mounted by something that does not record an identity (USB_sync.sh's
		# remount). The source is the partition that is here now; adopt it.
		part_identity "$PARTITION" > "$IDENTITY"
		HAVE="$WANT"
	fi

	if [ -n "$WANT" ] && [ "$WANT" = "$HAVE" ]; then
		# The mounted stick is the one plugged in. Also the normal outcome of
		# duplicate add/change events and of the boot/udev double run.
		[ -e "$MONITOR" ] || touch "$MONITOR"
		log "Info: '$MOUNTPOINT' already mounted from '$HAVE'; nothing to do ($(since_start)ms)"
		exit 0
	fi

	# Mounted, but not from the stick that is here: stick gone, or re-inserted
	# and this mount is left over from the previous attach. The old code exited
	# 0 here with "already mounted" - mounted, announced, and no music.
	detach_mount "mounted '${HAVE:-unknown}', present '${WANT:-none}'" || exit 1
else
	# Nothing mounted: any flag is stale. Removing it tells usb_service the
	# truth; if a stick is present, the mount below raises it again.
	if [ -e "$MONITOR" ]; then
		log "Info: removing stale '$MONITOR'"
		rm -f "$MONITOR" "$IDENTITY"
	fi
fi

if [ -z "$PARTITION" ]; then
	# Normal at boot without a stick, and normal for add:
	# the stick was pulled again before this instance got the lock.
	log "Info: no ORADIO partition present; nothing to mount ($(since_start)ms)"
	exit 0
fi

mount_partition "$PARTITION"
